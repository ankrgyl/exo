#!/bin/sh
set -eu

export PATH=/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev

cmdline_value() {
    key="$1"
    for argument in $(cat /proc/cmdline); do
        case "$argument" in
            "$key"=*)
                printf '%s' "${argument#*=}"
                return 0
                ;;
        esac
    done
    return 1
}

# Firecracker exposes a TAP-backed virtio-net device but leaves guest addressing
# to the image/init. See https://github.com/firecracker-microvm/firecracker/blob/main/docs/network-setup.md#in-the-guest
ip link set lo up
if guest_ip="$(cmdline_value exo_guest_ip)"; then
    gateway="$(cmdline_value exo_gateway)"
    prefix="$(cmdline_value exo_prefix)"
    dns_server="$(cmdline_value exo_dns)"
    ip addr add "${guest_ip}/${prefix}" dev eth0
    ip link set eth0 up
    ip route add default via "$gateway"
    rm -f /etc/resolv.conf
    printf 'nameserver %s\noptions single-request-reopen\n' "$dns_server" >/etc/resolv.conf
fi

if workspace="$(cmdline_value exo_workspace)" && [ -b /dev/vdb ]; then
    mkdir -p "$workspace"
    mount -t ext4 /dev/vdb "$workspace"
    chown 10001:10001 "$workspace"
fi

export HOME=/home/exo
cd /home/exo/workspace
exec setpriv --reuid=10001 --regid=10001 --clear-groups python3 /runtime/exo-firecracker-agent.py
