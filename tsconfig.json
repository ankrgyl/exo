{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "*": ["./*"],
      "@exo/harness": ["./exoharness/typescript/harness/index.ts"],
      "@exo/harness/tool": ["./exoharness/typescript/harness/tool.ts"],
      "@exo/model-runtime/responses": [
        "./exoharness/typescript/model-runtime/responses.ts"
      ],
      "@exo/model-runtime/cost": [
        "./exoharness/typescript/model-runtime/cost.ts"
      ],
      "@exo/model-runtime/shared": [
        "./exoharness/typescript/model-runtime/shared.ts"
      ],
      "@exo/model-runtime/turn-loop": [
        "./exoharness/typescript/model-runtime/turn-loop.ts"
      ],
      "@exo/codex/app-server": ["./exoharness/typescript/codex/app-server.ts"],
      "@exo/cursor/sdk": ["./exoharness/typescript/cursor/sdk.ts"],
      "@exo/cursor/protocol": ["./exoharness/typescript/cursor/protocol.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "website/docs-src"]
}
